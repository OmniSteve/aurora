{
  "name": "DiscountCode",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage"
    },
    "value": {
      "type": "number"
    },
    "min_spend": {
      "type": "number",
      "default": 0
    },
    "starts_at": {
      "type": "string"
    },
    "ends_at": {
      "type": "string"
    },
    "usage_limit": {
      "type": "number"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "code",
    "value"
  ]
}