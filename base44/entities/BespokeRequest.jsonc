{
  "name": "BespokeRequest",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "jewellery_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inspiration": {
      "type": "string"
    },
    "materials": {
      "type": "string"
    },
    "stones": {
      "type": "string"
    },
    "approximate_size": {
      "type": "string"
    },
    "budget": {
      "type": "string"
    },
    "completion_date": {
      "type": "string"
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "more_info",
        "quote_prepared",
        "quote_sent",
        "accepted",
        "deposit_required",
        "in_production",
        "ready",
        "completed",
        "declined"
      ],
      "default": "new"
    },
    "quote": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "customisation": {
          "type": "string"
        },
        "materials": {
          "type": "string"
        },
        "stones": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "deposit_type": {
          "type": "string",
          "enum": [
            "fixed",
            "percentage"
          ]
        },
        "deposit_value": {
          "type": "number"
        },
        "estimated_completion": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "internal_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "customer_name",
    "email"
  ]
}