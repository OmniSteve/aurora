{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aurora-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "env": {
    "dev": {
      "name": "aurora-api-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aurora-dev",
          "database_id": "5c590ff8-7a0c-4678-98a4-0e6b90376fd6",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA_PUBLIC", "bucket_name": "aurora-media-dev" },
        { "binding": "UPLOADS_PRIVATE", "bucket_name": "aurora-uploads-dev" }
      ],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "4001", "simple": { "limit": 10, "period": 10 } },
        { "name": "RL_PUBLIC", "namespace_id": "4002", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "EMAIL_FROM": "onboarding@resend.dev",
        // Base URL used to build links in transactional emails (order
        // confirmation, balance-payment request) -- read from env rather
        // than a request's own Origin so it's stable for emails sent from
        // contexts with no inbound request at all (the Cron sweep, the
        // Stripe webhook).
        "PUBLIC_ORIGIN": "https://aurora-api-dev.omni-design.workers.dev"
      },
      // Reservation-expiry sweep (worker/src/scheduled.js) -- every 5
      // minutes, matching the 30-minute reservation hold window with room
      // to catch an abandoned checkout well before it would meaningfully
      // block other buyers.
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // /api/*, /media/* and /media-private/* always run the Worker
        // script first -- none of them is ever resolved as a static asset
        // or falls through to the SPA's index.html, even when no route
        // below it matches.
        "run_worker_first": ["/api/*", "/media/*", "/media-private/*"]
      }
    },

    "production": {
      "name": "aurora-api",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aurora-production",
          "database_id": "05d40f4f-8077-43d3-81f1-29e3fce75106",
          "migrations_dir": "worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "MEDIA_PUBLIC", "bucket_name": "aurora-media" },
        { "binding": "UPLOADS_PRIVATE", "bucket_name": "aurora-uploads" }
      ],
      // Distinct from env.dev's 4001/4002 (Phase 10B finding) -- same limits/
      // periods, just isolated counters so dev traffic can never contribute
      // to (or be throttled by) production's rate-limit state.
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "5001", "simple": { "limit": 10, "period": 10 } },
        { "name": "RL_PUBLIC", "namespace_id": "5002", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "EMAIL_FROM": "onboarding@resend.dev", // placeholder -- replace with a verified Aurora domain before Phase 10C-2
        "PUBLIC_ORIGIN": "https://aurora.example.com" // placeholder -- replace with the real production domain before Phase 10C-2
      },
      // Reservation-expiry sweep -- was missing entirely (Phase 10B BLOCKER
      // #1); without this the oversell-race protection in
      // worker/migrations/0010_reservation_lifecycle.sql never runs in
      // production. Same cadence as env.dev.
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "assets": {
        "directory": "dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        // Was missing /media/* and /media-private/* (Phase 10B BLOCKER #2)
        // -- product/branding images and private uploads would not have
        // been Worker-routed in production. Matches env.dev.
        "run_worker_first": ["/api/*", "/media/*", "/media-private/*"]
      }
    }
  }
}
